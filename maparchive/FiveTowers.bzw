world
	size 400
end

options
	-set _noClimb 0
	-set _shockOutRadius 60
	-ms 5
	-j
	+r
	-a 50 38
	-sb
	-fb
	-noTeamKills
	-mp 0,0,20,20,20,20
	-c
	-sl GM 5
	-sl G 1
	-set _tankSpeed 50
	-set _shotsKeepVerticalVelocity 0
	-set _wingsJumpCount 5
	-mp 10,10,10,10,10,10
	-loadplugin ScoreRestorer
end

physics
	name Tower
	linear 0 0 90
end

physics
	name High
	linear 0 0 50
end

material
  name Hunt
  texture wall
end

#material
#  name GroundMaterial
#  texture http://images.bzflag.org/jefenry/Africa.png
#end

material
  name grass
  texture std_ground
end

material
  name ice
  texture https://images.bzflag.org/flast/bluewall.png
end

material
  name caution
  texture caution
end

material
name parainvisible
color 1 1 1 0.35
end

material
name invisible
color 1 1 1 0
end

material
name grey
texture pyrwall
diffuse 0.05 0.05 0.05 1
end

textureMatrix 
  name bluepyr
  spin 0
  center 0 0
end

material
	name blue
        addtexture pyrwall
	diffuse 0 0 1 1
	texmat bluepyr
	dyncol -1
end

textureMatrix 
  name greenpyr
  spin 0
  center 0 0
end

material
	name green
        addtexture pyrwall
	diffuse 0 1 0 1
	texmat greenpyr
	dyncol -1
end

textureMatrix 
  name redpyr
  spin 0
  center 0 0
end

material
	name red
        addtexture pyrwall
	diffuse 1 0 0 1
	texmat redpyr
	dyncol -1
end

textureMatrix 
  name purplepyr
  spin 0
  center 0 0
end

material
	name purple
        addtexture pyrwall
	diffuse 1 0 1 1
	texmat purplepyr
	dyncol -1
end

physics
name sharppyramids
death Be careful - this is defended!
end

