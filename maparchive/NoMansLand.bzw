zone
	size 400 400 1
	position 0 0 0
	zoneflag T 20
	zoneflag N 10
	zoneflag GM 15
	zoneflag SR 5
	zoneflag CL 15
	team 0
end

zone
	position 0 0 10
	size 10 10 1
	zoneflag L 5
	zoneflag WG 7
	zoneflag ST 5
	zoneflag OO 1
	zoneflag SR 4
	zoneflag N 5
#	team 0
end

zone
	size 10 10 1
	position 0 0 10
#	zoneflag DD 6
	zoneflag OO 10
	zoneflag SR 4
end

material
	name hex
        texture http://images.bzflag.org/bjackson/brown_brick.png
end

material
	name GroundMaterial
        texture http://images.bzflag.org/jfishbeck/A%20Distraction_pyrwallgreen.png
end

material
	name radarmesh
        texture http://images.bzflag.org/jfishbeck/A%20Distraction_pyrwallgreen.png
end

material
	name mesh
        texture http://images.bzflag.org/jfishbeck/A%20Distraction_pyrwallgreen.png
	noradar
end

material
	name grass
        texture std_ground
end

material
	name blue-s
        texture pyrwall
	diffuse 0 0 0.25 0.25
end

material
	name blue
        texture pyrwall
	diffuse 0 0 0.25 1
end

material
	name green
        texture pyrwall
	diffuse 0 0.25 0 1
end

material
	name green-s
        texture pyrwall
	diffuse 0 0.25 0 0.25
end

material
	name red
        texture pyrwall
	diffuse 0.25 0 0 1
end

material
	name red-s
        texture pyrwall
	diffuse 0.25 0 0 0.25
end

material
	name invisible
	diffuse 0 0 0 0
	noradar
end

material
	name wall
	texture wall
end

# Also invisible, but shows on radar
material
	name radaronly
	diffuse 1 1 1 0
end

define tri_prism

mesh
	name tri_prism

	vertex .7071067812 .7071067812 1
	vertex -0.9659258263 .2588190451 1
	vertex -0.9659258263 .2588190451 0
	vertex .7071067812 .7071067812 0
	vertex .2588190451 -0.9659258263 1
	vertex .2588190451 -0.9659258263 0

	face
		vertices 1 0 3 2
		matref red
	endface
	face
		vertices 4 1 2 5
		matref red
	endface
	face
		vertices 0 4 5 3
		matref red
	endface
	face
		vertices 0 1 4
		matref red
	endface
	face
		vertices 2 3 5
		matref red
	endface

	inside 0 0 0.5
end

enddef

define tri_roof

mesh
	name tri_roof

	vertex -0.9659258263 .2588190451 0
	vertex .7071067812 .7071067812 0
	vertex .2588190451 -0.9659258263 0

	face
		vertices 0 1 2
		matref red
	endface
	face
		vertices 2 1 0
		matref red
		drivethrough
	endface

end

enddef
	

