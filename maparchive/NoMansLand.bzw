define transbd
  mesh
    vertex 1.00000000 1.00000000 0.00000000
    vertex 1.00000000 -1.00000000 0.00000000
    vertex -1.00000000 -1.00000000 0.00000000
    vertex -1.00000000 1.00000000 0.00000000
    vertex 1.00000000 1.00000000 1.00000000
    vertex 1.00000000 -1.00000000 1.00000000
    vertex -1.00000000 -1.00000000 1.00000000
    vertex -1.00000000 1.00000000 1.00000000
    face
      vertices 0 1 2 3
#      matref blue
      driveThrough
       shootthrough
    endface
    face
      vertices 1 0 4 5
#      matref blue
      driveThrough
       shootthrough
    endface
    face
      vertices 2 1 5 6
#      matref blue
      driveThrough
    endface
    face
      vertices 3 2 6 7
#      matref blue
      driveThrough
    endface
    face
      vertices 0 3 7 4
#      matref blue
      driveThrough
      passable
    endface
    face
      vertices 7 6 5 4
#      matref blue
       shootthrough
    endface
  end
enddef

