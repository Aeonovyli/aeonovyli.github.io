world
	size 1700.0
	noWalls
end

options
	-set _pauseDropTime 1
	-set _maxFlagGrabs 100
	-set _hideTeamFlagsOnRadar 1
	-set _spawnSafeSRMod 8
	-set _srRadiusMult 3
	-set _flagAltitude 2
	-set _flagHeight 1
	-set _maxBumpHeight 3
	-set _noClimb 0
	-set _rainBaseColor gray30
	-set _rainDensity 5000
	-set _rainSpread 1700
	-set _rainType rain
	-set _fogColor gray30
	-set _fogDensity .0015
	-set _fogMode fog
	-set _radarLimit 1200
	-set _jumpVelocity 20
	-set _shockOutRadius 80
	-set _tankSpeed 75
	-mp 1,15,15,15,0,10
	-loadplugin teamflaggeno
	-loadplugin ctfOverseer
	-set _shotsKeepVerticalVelocity 1
	-noTeamKills
	-set _wingsJumpCount 50
	-j
	-sl L 1
	-sl ST 50
	-sl GM 15
	-ms 20
	-fb
	-sb
	-c
	-a 0 0
	-srvmsg "No-Man's Land"
	-srvmsg "by red rider."
	-srvmsg "This version is in CTF and has been scaled slightly larger."
	-srvmsg "Have fun and play nice!"
	-srvmsg "This is a server of all ages, please keep it clean."
end
#	position 735 735 20
